# Copy to .env for local use, and add the same values in Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com (used to email the Skill.md downloads)
RESEND_API_KEY=

# Sender shown on the email. The domain must be verified in Resend.
SKILL_EMAIL_FROM="Shawny Hargrove <shawny@dreamtechconnect.io>"

# Where a copy of every Skill.md request is sent (also used as the reply-to address)
SKILL_NOTIFY_EMAIL=shawny@dreamtechconnect.io
